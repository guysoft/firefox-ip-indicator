{
  "manifest_version": 2,
  "name": "IP Indicator",
  "version": "1.0.0",
  "description": "Shows the IP address the current site is served from, and whether it is IPv4 or IPv6.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ip-indicator@guysoft",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "dns",
    "tabs",
    "webRequest",
    "clipboardWrite",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "IP Indicator",
    "default_icon": {
      "32": "icons/unknown.svg",
      "64": "icons/unknown.svg"
    },
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "48": "icons/unknown.svg",
    "96": "icons/unknown.svg"
  }
}
